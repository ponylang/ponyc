// Each of A2..A32 and B2..B32 provides both traits of the level below, so
// A32 reaches T0 through 2^31 paths. Making Top's literal of A32 walks those
// traits; the test expects it to finish within the runner's time limit and
// print T0's f, 0.
trait T0
  fun f(): U8 => 0
trait A1 is T0
trait B1 is T0
trait A2 is (A1 & B1)
trait B2 is (A1 & B1)
trait A3 is (A2 & B2)
trait B3 is (A2 & B2)
trait A4 is (A3 & B3)
trait B4 is (A3 & B3)
trait A5 is (A4 & B4)
trait B5 is (A4 & B4)
trait A6 is (A5 & B5)
trait B6 is (A5 & B5)
trait A7 is (A6 & B6)
trait B7 is (A6 & B6)
trait A8 is (A7 & B7)
trait B8 is (A7 & B7)
trait A9 is (A8 & B8)
trait B9 is (A8 & B8)
trait A10 is (A9 & B9)
trait B10 is (A9 & B9)
trait A11 is (A10 & B10)
trait B11 is (A10 & B10)
trait A12 is (A11 & B11)
trait B12 is (A11 & B11)
trait A13 is (A12 & B12)
trait B13 is (A12 & B12)
trait A14 is (A13 & B13)
trait B14 is (A13 & B13)
trait A15 is (A14 & B14)
trait B15 is (A14 & B14)
trait A16 is (A15 & B15)
trait B16 is (A15 & B15)
trait A17 is (A16 & B16)
trait B17 is (A16 & B16)
trait A18 is (A17 & B17)
trait B18 is (A17 & B17)
trait A19 is (A18 & B18)
trait B19 is (A18 & B18)
trait A20 is (A19 & B19)
trait B20 is (A19 & B19)
trait A21 is (A20 & B20)
trait B21 is (A20 & B20)
trait A22 is (A21 & B21)
trait B22 is (A21 & B21)
trait A23 is (A22 & B22)
trait B23 is (A22 & B22)
trait A24 is (A23 & B23)
trait B24 is (A23 & B23)
trait A25 is (A24 & B24)
trait B25 is (A24 & B24)
trait A26 is (A25 & B25)
trait B26 is (A25 & B25)
trait A27 is (A26 & B26)
trait B27 is (A26 & B26)
trait A28 is (A27 & B27)
trait B28 is (A27 & B27)
trait A29 is (A28 & B28)
trait B29 is (A28 & B28)
trait A30 is (A29 & B29)
trait B30 is (A29 & B29)
trait A31 is (A30 & B30)
trait B31 is (A30 & B30)
trait A32 is (A31 & B31)
trait B32 is (A31 & B31)
trait Top
  fun make(): A32 val => object val is A32 end
class C is Top
  new create() => None
actor Main
  new create(env: Env) => env.out.print(C.make().f().string())

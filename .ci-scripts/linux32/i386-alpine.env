# The Alpine release the i386 VM boots. The libs cache label is "alpine" plus
# ALPINE_BRANCH without its leading v (e.g. alpine3.24), so changing the branch
# also gives the cached LLVM a new name. NETBOOT_SHA256 is the published sha256 of
# alpine-netboot-${ALPINE_RELEASE}-x86.tar.gz.
ALPINE_BRANCH=v3.24
ALPINE_RELEASE=3.24.4
NETBOOT_SHA256=47283eb7cc4e64926ec826f8363c89177a5141f30de72a6d252cc08938a9d055

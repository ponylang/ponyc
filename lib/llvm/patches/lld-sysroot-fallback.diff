# What: Fall back to the absolute path when a sysroot-prefixed path
#        does not exist in lld's linker script parser.
# Why: Cross-toolchains (e.g. Debian gcc-cross packages) install linker
#      scripts with fully-qualified paths that already include the
#      sysroot prefix. When lld prepends the sysroot again, the path
#      does not exist. Without this fallback, cross-compilation fails
#      with "cannot find /usr/lib/... inside /usr/...".
# Upstream: Not submitted. Upstream may prefer a different approach
#           to sysroot handling in linker scripts.
# Still needed: Yes, for cross-compilation with Debian-packaged
#               cross-toolchains (e.g. gcc-riscv64-linux-gnu).
# Test: Remove the patch, rebuild, cross-compile for riscv64 with
#       --sysroot pointing at a Debian cross-toolchain. Linking fails
#       with "cannot find ... inside ...".

diff --git i/lld/ELF/ScriptParser.cpp w/lld/ELF/ScriptParser.cpp
index ddfa24d9c..3753e0929 100644
--- i/lld/ELF/ScriptParser.cpp
+++ w/lld/ELF/ScriptParser.cpp
@@ -314,10 +314,17 @@ void ScriptParser::addFile(StringRef s) {
   if (curBuf.isUnderSysroot && s.starts_with("/")) {
     SmallString<128> pathData;
     StringRef path = (ctx.arg.sysroot + s).toStringRef(pathData);
-    if (sys::fs::exists(path))
+    if (sys::fs::exists(path)) {
       ctx.driver.addFile(ctx.saver.save(path), /*withLOption=*/false);
-    else
+    } else if (sys::fs::exists(s)) {
+      // The path already exists as an absolute path on the filesystem.
+      // This handles cross-toolchains (e.g. Debian gcc-cross packages)
+      // whose linker scripts use fully-qualified paths that already
+      // include the sysroot prefix.
+      ctx.driver.addFile(s, /*withLOption=*/false);
+    } else {
       setError("cannot find " + s + " inside " + ctx.arg.sysroot);
+    }
     return;
   }
 

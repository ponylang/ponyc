# What: Add CGSCCOptimizerLateEP callback to the full-LTO pipeline.
# Why: LLVM's full-LTO pipeline has no extension point after the CGSCC
#      inliner, so libponylto's HeapToStack pass cannot run after
#      cross-module inlining. This adds the same CGSCCOptimizerLateEP
#      hook that the default (non-LTO) pipeline already has.
# Upstream: Not submitted. LLVM may not want an EP this late in LTO.
# Still needed: Yes, as long as HeapToStack runs as an LTO plugin.
# Test: Remove the patch, rebuild, run benchmark/optimization/cross-package.
#       HeapToStack won't fire on cross-package allocations because the
#       inliner hasn't run yet when the pass would normally execute.

diff --git i/llvm/lib/Passes/PassBuilderPipelines.cpp w/llvm/lib/Passes/PassBuilderPipelines.cpp
index 1584d3087..dc9a04d06 100644
--- i/llvm/lib/Passes/PassBuilderPipelines.cpp
+++ w/llvm/lib/Passes/PassBuilderPipelines.cpp
@@ -2114,11 +2114,13 @@ PassBuilder::buildLTODefaultPipeline(OptimizationLevel Level,
                                   UseInlineAdvisor,
                                   ThinOrFullLTOPhase::FullLTOPostLink));
   } else {
-    MPM.addPass(ModuleInlinerWrapperPass(
+    ModuleInlinerWrapperPass MIWP(
         getInlineParamsFromOptLevel(Level),
         /* MandatoryFirst */ true,
         InlineContext{ThinOrFullLTOPhase::FullLTOPostLink,
-                      InlinePass::CGSCCInliner}));
+                      InlinePass::CGSCCInliner});
+    invokeCGSCCOptimizerLateEPCallbacks(MIWP.getPM(), Level);
+    MPM.addPass(std::move(MIWP));
   }

   // Perform context disambiguation after inlining, since that would reduce the

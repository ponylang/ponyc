 }
 
+// Lower FMAXIMUM/FMINIMUM on f64 for targets where FMAXNUM/FMINNUM f64 is
+// Legal (vmaxnm.f64/vminnm.f64 on FP-ARMv8) but there is no corresponding
+// f64 instruction for the IEEE 754-2019 semantics.  The generic Expand uses
+// IS_FPCLASS for the signed-zero fixup, which the 32-bit ARM backend cannot
+// select for f64.
+static SDValue LowerFMAXIMUM_FMINIMUM(SDValue Op, SelectionDAG &DAG) {
+  SDLoc DL(Op);
+  EVT VT = Op.getValueType();
+  SDValue LHS = Op.getOperand(0);
+  SDValue RHS = Op.getOperand(1);
+  unsigned Opc = Op.getOpcode();
+  bool IsMax = (Opc == ISD::FMAXIMUM);
+
+  EVT CCVT = MVT::i32;
+
+  // 1. Base result from FMAXNUM/FMINNUM (vmaxnm.f64/vminnm.f64).
+  unsigned BaseOpc = IsMax ? ISD::FMAXNUM : ISD::FMINNUM;
+  SDValue Result = DAG.getNode(BaseOpc, DL, VT, LHS, RHS);
+
+  // 2. NaN propagation: if either operand is NaN, result is NaN.
+  SDValue IsUnordered = DAG.getSetCC(DL, CCVT, LHS, RHS, ISD::SETUO);
+  SDValue NaN = DAG.getConstantFP(
+      APFloat::getNaN(APFloat::IEEEdouble()), DL, VT);
+  Result = DAG.getSelect(DL, VT, IsUnordered, NaN, Result);
+
+  // 3. Signed-zero: IEEE 754-2019 maximum(-0,+0) = +0 (and minimum = -0).
+  //    vmaxnm treats +0 == -0 and may return either.  When the result is
+  //    zero, pick the correct sign.
+  //
+  //    For maximum: result is -0 only when both inputs are -0.
+  //      => bitcast_f64(bitcast_i64(LHS) AND bitcast_i64(RHS))
+  //    For minimum: result is +0 only when both inputs are +0.
+  //      => bitcast_f64(bitcast_i64(LHS) OR  bitcast_i64(RHS))
+  //
+  //    Use VMOVRRD/VMOVDRR to move between f64 and i32 pairs — i64 is not
+  //    a legal type on 32-bit ARM.
+  SDValue IsZero = DAG.getSetCC(DL, CCVT, Result,
+                                DAG.getConstantFP(0.0, DL, VT), ISD::SETOEQ);
+
+  SDValue LHSPair = DAG.getNode(ARMISD::VMOVRRD, DL,
+      DAG.getVTList(MVT::i32, MVT::i32), LHS);
+  SDValue RHSPair = DAG.getNode(ARMISD::VMOVRRD, DL,
+      DAG.getVTList(MVT::i32, MVT::i32), RHS);
+
+  unsigned CombineOpc = IsMax ? ISD::AND : ISD::OR;
+  SDValue ZeroLo = DAG.getNode(CombineOpc, DL, MVT::i32,
+      LHSPair.getValue(0), RHSPair.getValue(0));
+  SDValue ZeroHi = DAG.getNode(CombineOpc, DL, MVT::i32,
+      LHSPair.getValue(1), RHSPair.getValue(1));
+
+  SDValue ZeroResult = DAG.getNode(ARMISD::VMOVDRR, DL, MVT::f64,
+      ZeroLo, ZeroHi);
+
+  Result = DAG.getSelect(DL, VT, IsZero, ZeroResult, Result);
+
+  return Result;
+}

file(REMOVE_RECURSE "${OUTPUT}")
file(MAKE_DIRECTORY "${OUTPUT}")
file(STRINGS "${TEST_SRC}/main.pony" _source)
set(_line 0)
foreach(_text IN LISTS _source)
    math(EXPR _line "${_line} + 1")
    if(_text MATCHES "fun ref ([a-z]+)_result")
        math(EXPR _site_${CMAKE_MATCH_1} "${_line} + 1")
    elseif(_text MATCHES "return \"original\"")
        set(_site_early "${_line}")
    elseif(_text MATCHES "fun apply")
        set(_site_generic "${_line}")
    endif()
endforeach()

function(run_case mutant changed)
    execute_process(
        COMMAND "${CMAKE_COMMAND}" -E env "PONY_MUTANT_ID=${mutant}"
            "${_bin}" --ponynoscale --ponymaxthreads=1
        RESULT_VARIABLE _rc
        OUTPUT_VARIABLE _out
        ERROR_VARIABLE _err
        TIMEOUT 30
    )
    if(NOT _rc EQUAL 0)
        message(FATAL_ERROR "${_mode} mutant ${mutant}: ${_rc}\n${_out}\n${_err}")
    endif()
    string(REPLACE "\r\n" "\n" _out "${_out}")
    foreach(_key val box ref iso trn tag alias explicit generic calls)
        set(_expected 8)
        if(_key STREQUAL "ref")
            set(_expected "8:8")
        elseif(_key STREQUAL "tag")
            set(_expected "true")
        elseif(_key STREQUAL "calls")
            set(_expected 9)
        endif()
        if(_key STREQUAL changed)
            set(_expected 0)
            if(_key STREQUAL "ref")
                set(_expected "0:0")
            elseif(_key STREQUAL "tag")
                set(_expected "false")
            endif()
        endif()
        string(REGEX MATCH "(^|\n)${_key}=([^\n]*)" _match "${_out}")
        if(NOT _match OR NOT CMAKE_MATCH_2 STREQUAL _expected)
            message(FATAL_ERROR
                "${_mode} mutant ${mutant}: ${_key} expected '${_expected}',"
                " output '${_out}'")
        endif()
    endforeach()
endfunction()

foreach(_mode debug release)
    set(_dir "${OUTPUT}/${_mode}")
    file(MAKE_DIRECTORY "${_dir}")
    set(_bin "${_dir}/mutation-string")
    if(WIN32)
        string(APPEND _bin ".exe")
    endif()
    set(_flags "")
    if(_mode STREQUAL "debug")
        list(APPEND _flags -d)
    endif()
    execute_process(
        COMMAND "${COMPILER}" ${_flags} --mutate --mutate-operators=rvr
            --mutate-scope=main.pony -b mutation-string
            --output "${_dir}" "${TEST_SRC}"
        RESULT_VARIABLE _rc
        OUTPUT_VARIABLE _out
        ERROR_VARIABLE _err
        TIMEOUT 120
    )
    if(NOT _rc EQUAL 0)
        message(FATAL_ERROR "${_mode} compilation: ${_rc}\n${_out}\n${_err}")
    endif()
    file(READ "${_dir}/mutation-string.mutants.json" _json)
    string(JSON _count LENGTH "${_json}" mutants)
    if(NOT _count EQUAL 10)
        message(FATAL_ERROR "expected ten String return mutants: ${_json}")
    endif()
    run_case(0 none)
    file(READ "${_bin}.coverage" _coverage HEX)
    set(_seen "")
    math(EXPR _last "${_count} - 1")
    foreach(_index RANGE 0 ${_last})
        foreach(_field id line category original replacement shared coverage_counter)
            string(JSON _${_field} GET "${_json}" mutants ${_index} ${_field})
        endforeach()
        if(NOT _category STREQUAL "rvr" OR NOT _original STREQUAL "return"
                OR NOT _replacement STREQUAL "\"\"")
            message(FATAL_ERROR "unexpected String metadata: ${_json}")
        endif()
        set(_changed "")
        foreach(_key val box ref iso trn tag alias explicit generic early)
            if(_line EQUAL _site_${_key})
                set(_changed "${_key}")
            endif()
        endforeach()
        if(_changed STREQUAL "" OR _changed IN_LIST _seen)
            message(FATAL_ERROR "unknown or duplicate return site: ${_json}")
        endif()
        list(APPEND _seen "${_changed}")
        if((_changed STREQUAL "generic" AND NOT _shared)
                OR (NOT _changed STREQUAL "generic" AND _shared))
            message(FATAL_ERROR "incorrect String sharing: ${_json}")
        endif()
        math(EXPR _offset "(4 + ${_coverage_counter} * 8) * 2")
        string(SUBSTRING "${_coverage}" ${_offset} 16 _hit)
        if(_changed STREQUAL "explicit")
            if(NOT _hit STREQUAL "0000000000000000")
                message(FATAL_ERROR "unreached implicit return marked covered")
            endif()
            run_case(${_id} none)
        else()
            if(_hit STREQUAL "0000000000000000")
                message(FATAL_ERROR "reached String return lacks coverage")
            endif()
            if(_changed STREQUAL "early")
                set(_changed explicit)
            endif()
            run_case(${_id} "${_changed}")
        endif()
    endforeach()
    run_case(2147483647 none)
endforeach()
